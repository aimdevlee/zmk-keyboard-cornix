// Language switching for Cornix keyboard
// Direct key mapping on left outer pinky column (pos 0, 12, 24)
// Works with existing Karabiner-Elements configuration

/*
  Language switching keys:
  - Pos 0  (top left outer pinky)    → English + BASE(Colemak-DH)
  - Pos 12 (middle left outer pinky) → Japanese Hiragana + BASE(Colemak-DH)
  - Pos 24 (bottom left outer pinky) → Korean + EXTRA(QWERTY)

  These keys are mapped in config/miryoku/mapping/cornix.h
  Combos are no longer used for language switching
*/

/ {
  macros {
    // Macro: Switch to Korean + EXTRA(QWERTY) layer
    lang_korean: lang_korean {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings = <&kp LANG1>, <&kp LC(LA(SPACE))>, <&to U_EXTRA>;
    };

    // Macro: Switch to English + BASE(Colemak-DH) layer
    lang_english: lang_english {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings = <&kp LANG2>, <&to U_BASE>;
    };

    // Macro: Switch to Japanese + BASE(Colemak-DH) layer
    lang_japanese: lang_japanese {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings = <&kp LANG1>, <&to U_BASE>;
    };
  };

  // Combos removed - language switching now uses dedicated keys (pos 0, 12, 24)
  // See config/miryoku/mapping/cornix.h for key assignments
};
